# Copy values into your shell environment; gateway.py does not auto-load this file.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_MODE=mock
# xiaozhi 需要自建 xiaozhi-esp32-server；llm 直连 OpenAI 兼容接口，不需要该服务端。
# 三种模式：mock（不调用模型）、xiaozhi（自建服务端 WebSocket）、llm（模型 API）。
# Required when listening beyond loopback; enter this gateway-only code in the App.
GATEWAY_TOKEN=
# Set mode=xiaozhi after configuring an actual upstream; no implicit fallback.
XIAOZHI_WS_URL=ws://127.0.0.1:8000/xiaozhi/v1/
XIAOZHI_DEVICE_ID=
XIAOZHI_CLIENT_ID=medication-android-gateway
# Upstream credential stays on the server, never entered in the Android App.
XIAOZHI_TOKEN=
XIAOZHI_TIMEOUT_SECONDS=45

# --- mode=llm：直连 OpenAI 兼容接口，不需要 xiaozhi 服务端 ---
# LLM_BASE_URL 写到 /chat/completions 之前，例如 https://api.deepseek.com/v1
# 非回环地址必须是 https；只有 127.0.0.1 / localhost 允许 http（本地 Ollama 等）。
# API Key 只存在于本服务端，不要写进 App、APK、构建参数或仓库。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
